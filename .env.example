# ===== 必填（线上）=====
# 云数据库连接串（Neon / Vercel Postgres 均提供）。不配置时自动退化为本地文件存储，
# 本地文件存储只适合本机测试，线上（Vercel）必须配置，否则数据不落库。
DATABASE_URL=

# 管理后台登录密码（自己设一个强密码，例如 16 位随机串）
ADMIN_PASSWORD=change-me-please

# 登录态签名密钥（随便一串长随机字符，改掉它可让所有已登录会话失效）
AUTH_SECRET=please-change-this-secret-string

# ===== 可选 =====
# 站点展示名称
NEXT_PUBLIC_SITE_NAME=卡密退款登记
# 登记截止提示文案（留空则不显示）
NEXT_PUBLIC_DEADLINE_NOTE=
# 客服联系方式，显示在成功页与查询页
NEXT_PUBLIC_SUPPORT_CONTACT=
